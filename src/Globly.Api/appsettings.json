{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Only reachable through cloudflared on the same machine.
  "Urls": "http://127.0.0.1:5021",

  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=globly;Username=globly;Password=CHANGE_ME"
  },

  "Jwt": {
    "Issuer": "globly-api",
    "Audience": "globly-app",
    // Set via environment variable Jwt__Key (>= 32 chars). Never commit the real key.
    "Key": "",
    "ExpiryDays": 30
  },

  // Optional bootstrap admin, created on startup if both are set (use env vars Admin__UserName / Admin__Password).
  "Admin": {
    "UserName": "",
    "Password": ""
  },

  "Storage": {
    // "R2" in production, "Local" for development without Cloudflare.
    "Provider": "R2",
    "R2": {
      "AccountId": "",
      "AccessKeyId": "",
      "SecretAccessKey": "",
      "Bucket": "globly-media",
      // Public bucket domain, e.g. "https://media.your-domain.com". Leave empty to hand out presigned URLs.
      "PublicBaseUrl": "https://media.dagnis.my.id",
      "PresignedUrlMinutes": 60
    }
  },

  "Moderation": {
    // Community moderation: a post is hidden automatically when this many users report it...
    "ReportThreshold": 5,
    // ...or when it has at least DownvoteHideMinVotes votes and DownvoteHidePercent% are downvotes.
    "DownvoteHideMinVotes": 10,
    "DownvoteHidePercent": 80,
    "BannedWords": [],
    // NSFW filter for photos and videos, run in the background after publishing (see README).
    "Nsfw": {
      "Enabled": true,
      "ModelPath": "models/nsfw.onnx",
      // At or above HideThreshold the post is hidden for review; at or above ReviewThreshold it
      // stays visible but goes to the admin queue.
      "HideThreshold": 0.9,
      "ReviewThreshold": 0.6
    }
  },

  "Capture": {
    // Unattested media is hidden for review; true rejects it instead.
    "RejectUnverified": false,
    "Attestation": {
      "PackageName": "com.globly.globly",
      // Release signing cert SHA-256 (keytool -list -v). Empty: all media goes to review.
      "SigningCertSha256": [],
      "RequireLockedDevice": true
    }
  },

  // Cloudflare Turnstile human check at registration. Disabled while either key is empty.
  // Set via environment variables Turnstile__SiteKey / Turnstile__SecretKey.
  "Turnstile": {
    "SiteKey": "",
    "SecretKey": ""
  },

  "Cors": {
    // Sites allowed to call the API from a browser (the Flutter web demo).
    "AllowedOrigins": [ "https://globly.dagnis.my.id" ]
  },

  "ReverseProxy": {
    // Extra trusted proxy networks (CIDR) if cloudflared does not run on loopback, e.g. in Docker.
    "KnownNetworks": []
  }
}
