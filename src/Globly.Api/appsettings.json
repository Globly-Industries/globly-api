{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Only reachable through cloudflared on the same machine.
  "Urls": "http://127.0.0.1:5021",

  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=globly;Username=globly;Password=CHANGE_ME"
  },

  "Jwt": {
    "Issuer": "globly-api",
    "Audience": "globly-app",
    // Set via environment variable Jwt__Key (>= 32 chars). Never commit the real key.
    "Key": "",
    "ExpiryDays": 30
  },

  // Optional bootstrap admin, created on startup if both are set (use env vars Admin__UserName / Admin__Password).
  "Admin": {
    "UserName": "",
    "Password": ""
  },

  "Storage": {
    // "R2" in production, "Local" for development without Cloudflare.
    "Provider": "R2",
    "R2": {
      "AccountId": "",
      "AccessKeyId": "",
      "SecretAccessKey": "",
      "Bucket": "globly-media",
      // Public bucket domain, e.g. "https://media.your-domain.com". Leave empty to hand out presigned URLs.
      "PublicBaseUrl": "https://media.dagnis.my.id",
      "PresignedUrlMinutes": 60
    }
  },

  "Moderation": {
    "ReportThreshold": 5,
    "BannedWords": []
  },

  "Cors": {
    // Sites allowed to call the API from a browser (the Flutter web demo).
    "AllowedOrigins": [ "https://globly.dagnis.my.id" ]
  },

  "ReverseProxy": {
    // Extra trusted proxy networks (CIDR) if cloudflared does not run on loopback, e.g. in Docker.
    "KnownNetworks": []
  }
}
