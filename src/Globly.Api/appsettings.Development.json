{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },

  // 0.0.0.0 so a physical phone on the LAN can reach the dev server. The emulator uses 10.0.2.2.
  "Urls": "http://0.0.0.0:5021",

  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=globly;Username=globly;Password=globly_dev"
  },

  "Jwt": {
    // DEVELOPMENT ONLY. Production must set Jwt__Key.
    "Key": "dev-only-key-0123456789-abcdefghijklmnopqrstuvwxyz"
  },

  "Admin": {
    "UserName": "admin",
    "Password": "admin12345"
  },

  "Storage": {
    "Provider": "Local",
    "Local": {
      "RootPath": "media",
      // Android emulator reaches the host's localhost via 10.0.2.2.
      "PublicBaseUrl": "http://10.0.2.2:5021/media"
    }
  }
}
