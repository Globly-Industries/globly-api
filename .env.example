# Copy to .env on the server and fill in. Never commit .env.

# Database password (any long random string).
POSTGRES_PASSWORD=

# JWT signing key, at least 32 random characters.
JWT_KEY=

# Cloudflare R2 (R2 overview page + API token with Object Read & Write on the bucket).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=globly-media

# Cloudflare Tunnel token (Zero Trust -> Networks -> Tunnels -> globly -> the long "eyJ..." value).
CLOUDFLARE_TUNNEL_TOKEN=

# Optional: Cloudflare Turnstile human check at registration (dashboard -> Turnstile -> Add widget).
# Leave empty to disable.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Release APK signing cert SHA-256 (keytool -list -v). Empty: all media goes to review.
ANDROID_SIGNING_CERT_SHA256=
# true: reject unattested media instead of hiding it (also blocks web).
REJECT_UNVERIFIED_MEDIA=false

# Optional: admin account created on first start.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
